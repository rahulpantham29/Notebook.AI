# Environment Variable Configuration for NotebookAI RAG App

# LLM & Embedding Providers (Optional: system automatically falls back to smart local engine if key is not provided)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database Configuration
VECTOR_DB_TYPE=memory

# RAG Pipeline Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
